# EditorConfig: https://editorconfig.org
root = true

# ─── Defaults (all files) ──────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

# ─── C# ────────────────────────────────────────────────────────────────────
[*.cs]
indent_size = 4

# ─── JavaScript / TypeScript ───────────────────────────────────────────────
[*.{js,mjs,cjs,ts,tsx,jsx}]
indent_size = 2

# ─── Web templates ─────────────────────────────────────────────────────────
[*.{html,razor,cshtml}]
indent_size = 2

# ─── CSS / SCSS ────────────────────────────────────────────────────────────
[*.{css,scss,sass,less}]
indent_size = 2

# ─── JSON ──────────────────────────────────────────────────────────────────
[*.{json,jsonc}]
indent_size = 2

# ─── YAML ──────────────────────────────────────────────────────────────────
[*.{yml,yaml}]
indent_size = 2

# ─── SQL ───────────────────────────────────────────────────────────────────
[*.sql]
indent_size = 4

# ─── Markdown ──────────────────────────────────────────────────────────────
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# ─── Shell scripts ─────────────────────────────────────────────────────────
[*.sh]
end_of_line = lf
indent_size = 2

# ─── XML / Project files ───────────────────────────────────────────────────
[*.{xml,csproj,vbproj,sqlproj,props,targets,resx,config}]
indent_size = 2

# ─── Python ────────────────────────────────────────────────────────────────
[*.py]
indent_size = 4
